      "seconds": 337.69,
      "answer": "```python\ndef rle_bytes(data: bytes) -> bytes:\n    if not data:\n        return b''\n    \n    result = bytearray()\n    i = 0\n    n = len(data)\n    \n    while i < n:\n        current_byte = data[i]\n        count = 0\n        \n        # Contar la racha del byte actual\n        while i + count < n and data[i + count] == current_byte:\n            count += 1\n        \n        # Dividir la racha en bloques de máximo 255\n        while count > 0:\n            chunk_size = min(count, 255)\n            result.append(chunk_size)\n            result.append(current_byte)\n            count -= chunk_size\n        \n        i += (count + (count if count == 0 else 0)) # This logic is simplified below\n        # Corrected loop logic:\n        # The inner while already finds the full length of the run.\n        # We just need to move the index by the total count found.\n    \n    # Re-writing the loop logic for clarity and correctness:\n    result = bytearray()\n    i = 0\n    while i < len(data):\n        current_byte = data[i]\n        run_length = 0\n        while i + run_length < len(data) and data[i + run_length] == current_byte:\n            run_length += 1\n        \n        # Process the run_length in chunks of 255\n        while run_length > 255:\n            result.append(255)\n            result.append(current_byte)\n            run_length -= 255\n        \n        if run_length > 0:\n            result.append(run_length)\n            result.append(current_byte)\n        \n        i += (run_length + (0 if run_length == 0 else 0)) # This is just i += original_run_length\n        # Let's fix the index increment:\n        # The loop above already calculates the full run_length.\n        # The index i should jump by the total run_length.\n    \n    # Final clean implementation:\n    res = bytearray()\n    i = 0\n    while i < len(data):\n        char = data[i]\n        count = 0\n        while i + count < len(data) and data[i + count] == char:\n            count += 1\n        \n        # Split count into chunks of 255\n        while count > 255:\n            res.append(255)\n            res.append(char)\n            count -= 255\n        \n        if count > 0:\n            res.append(count)\n            res.append(char)\n        \n        i += (count + (0 if count == 0 else 0)) # This is wrong, it should be the original count\n    \n    # Let's provide the correct logic in one pass:",

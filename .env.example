# Copia este archivo como .env (en esta misma carpeta) y rellena solo lo que uses.
# .env está en .gitignore: nunca se sube a git. Eolfi lo lee al arrancar y no muestra los valores.
# Una variable ya definida en Windows tiene prioridad sobre el .env.

# GitHub (token personal): repositorios privados
GITHUB_TOKEN=

# Proveedores de IA por API
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# Ajustes opcionales
# EOLFI_COPILOT_WORKSPACE=read
# EOLFI_WEB_ORDER=meta,deepseek,gemini,lechat
